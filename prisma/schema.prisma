// LexLens — anonymous-session schema (SQLite).
//
// PRD (anonymous SaaS): there are NO user accounts and NO permanent history.
// Every piece of analysis data belongs to a temporary ANONYMOUS SESSION:
//   • AnalysisSession rows are keyed by a SHA-256 hash of the browser's
//     random session token (the raw token never touches the database).
//   • Every temporary record carries sessionId + expiresAt and is ALWAYS
//     queried through the data-access helpers, which verify session ownership
//     before returning anything (a foreign id yields a privacy-preserving 404).
//   • Expired records are purged automatically (see src/lib/session.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Temporary anonymous analysis session. `id` = SHA-256 of the session token.
model AnalysisSession {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  notices Notice[]
  reminders Reminder[]

  @@index([expiresAt])
}

/// The current analysis (a "case" being processed in this session only).
model Notice {
  id               String    @id @default(cuid())
  sessionId        String
  session          AnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title            String
  sourceLabel      String    @default("")
  // pdf | png | jpg | jpeg | webp | text
  fileType         String    @default("text")
  // Stored OUTSIDE public/ — served only through the session-checked file API.
  filePath         String?
  fileMime         String?
  fileSize         Int?
  noticeText       String    @default("")
  noticeType       String    @default("other")
  jurisdiction     String    @default("") // INDIA | USA | UNKNOWN ("")
  jurisdictionSource String  @default("") // auto | user
  legalDomain      String    @default("")
  noticeLanguage   String    @default("")
  severity         String    @default("yellow")
  claimedAmount    String?
  currency         String?
  noticeDate       DateTime?
  receiptDate      DateTime?
  deadlineDate     DateTime?
  deadlineRule     String?
  deadlineSourceId String?
  // JSON blob: { inputs, position, evidence } — mirrors UserCaseState
  userState        String    @default("{}")
  completed        Boolean   @default(false)
  analysisStatus   String    @default("PENDING") // PENDING | READY | FAILED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  expiresAt        DateTime

  report        AnalysisReport?
  drafts        ResponseDraft[]
  briefs        LawyerBrief[]
  evidences     Evidence[]
  reminders     Reminder[]

  @@index([sessionId, updatedAt])
  @@index([expiresAt])
}

/// Temporary deadline reminder (FEATURE: reminder system).
///
/// Reminders are ALWAYS anchored to the deterministically calculated deadline
/// (Notice.deadlineDate — produced by the deadline engine, never by the AI):
///   • `deadlineDate` snapshots the engine-computed deadline at set-time; the
///     API refuses to create a reminder when that anchor is missing or stale.
///   • At most ONE ACTIVE reminder exists per notice; setting/editing
///     replaces it, cancelling deletes it — no user history is kept.
///   • Rows are session-scoped (HttpOnly cookie session, no accounts) and
///     expire together with the analysis session (24h sliding TTL).
model Reminder {
  id           String    @id @default(cuid())
  sessionId    String
  session      AnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  noticeId     String
  notice       Notice    @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  // Snapshot of the deterministic deadline this reminder is anchored to.
  deadlineDate DateTime
  deadlineRule String?
  sourceId     String?
  // When to notify the user (absolute instant, client-local timezone aware).
  remindAt     DateTime
  // ACTIVE → NOTIFIED once the browser has been notified (fire exactly once).
  status       String    @default("ACTIVE")
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  expiresAt    DateTime

  @@index([sessionId])
  @@index([noticeId])
  @@index([status, remindAt])
  @@index([expiresAt])
}

/// Temporary analysis result for the current session's notice.
model AnalysisReport {
  id        String   @id @default(cuid())
  noticeId  String   @unique
  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  sessionId String
  baseData  String   // JSON — CaseBase (facts, citations, localized blocks…)
  metaJson  String   @default("{}") // internal processing metadata (never user-facing)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([sessionId])
  @@index([expiresAt])
}
/// Temporary evidence attached to the current session's notice.
model Evidence {
  id         String   @id @default(cuid())
  noticeId   String
  notice     Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  sessionId  String
  name       String
  mimeType   String
  size       Int
  storedPath String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([noticeId])
  @@index([sessionId])
  @@index([expiresAt])
}

/// Temporary response draft for the current session's notice.
model ResponseDraft {
  id        String   @id @default(cuid())
  sessionId String
  noticeId  String
  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  content   String
  source    String   @default("template") // ai | template
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([noticeId])
  @@index([sessionId])
}

/// Temporary lawyer brief for the current session's notice.
model LawyerBrief {
  id        String   @id @default(cuid())
  sessionId String
  noticeId  String
  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  content   String   // JSON — Brief
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([noticeId])
  @@index([sessionId])
}
